# Sesión headless (OpenClaw / Cursor). No hace falta LaLigaApp en el servidor.
# Copia este archivo a .env y rellena los valores.

# Bearer (access_token o id_token de Azure AD B2C)
LALIGA_FANTASY_TOKEN=

# Refresh token: necesario para renovar la sesión sin login interactivo
LALIGA_FANTASY_REFRESH_TOKEN=

# Client ID B2C que emitió los tokens (web o nativo/Google)
# Web: 6457fa17-1224-416a-b21a-ee6ce76e9bc0
# Nativo/Google:  af88bcff-1157-40a0-b579-030728aacf0b
LALIGA_FANTASY_CLIENT_ID=

# Liga por defecto (opcional; si vacío se usa la primera liga del usuario)
LALIGA_FANTASY_LEAGUE_ID=

# Política de pujas del MCP (por defecto: update_own)
#   readonly           — prohibido colocar y actualizar pujas
#   update_own         — prohibido crear pujas; se pueden actualizar las que ya hizo el usuario
#   create_and_update  — se pueden colocar pujas nuevas y actualizar las existentes
LALIGA_FANTASY_BID_POLICY=update_own
